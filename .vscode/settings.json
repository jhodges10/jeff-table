{
  // ── Editor ──────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.rulers": [100],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // ── Biome (format, lint, organize imports) ──────────────────────
  "editor.defaultFormatter": "biomejs.biome",
  "biome.requireConfiguration": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.defaultFormatter": "vscode.markdown-language-features",
    "editor.wordWrap": "on"
  },

  // ── TypeScript 7 (native Go compiler + language service) ────────
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript",
  "typescript.experimental.useTsgo": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.updateImportsOnFileMove.enabled": "always",

  // ── CSS ─────────────────────────────────────────────────────────
  "css.lint.unknownAtRules": "ignore",

  // ── File nesting ────────────────────────────────────────────────
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.test.ts, ${capture}.d.ts",
    "*.tsx": "${capture}.test.tsx",
    "package.json": "bun.lock, biome.json, tsconfig.json, tsconfig.build.json, vite.config.ts, vitest.config.ts, vercel.json, .editorconfig",
    "README.md": "LICENSE",
    ".gitignore": ".gitattributes, .editorconfig"
  },

  // ── Search / files ──────────────────────────────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/storybook-static": true,
    "**/bun.lock": true
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/coverage": true,
    "**/dist": true,
    "**/storybook-static": true,
    "**/*.tsbuildinfo": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/storybook-static/**": true
  }
}
